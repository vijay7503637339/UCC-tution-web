Options -Indexes
<FilesMatch "^(\.env(\..*)?|\.gitignore|composer\.(json|lock)|README\.md)$">
  Require all denied
</FilesMatch>
RewriteEngine On
RewriteRule ^(\.git|\.github)/ - [F,L,NC]
RewriteRule ^(src|database|migration|storage|bin|tests|vendor)/ - [F,L,NC]
# Keep the application source outside the public entry point.
RewriteRule ^$ public/ [L]
RewriteRule ^(.*)$ public/$1 [L]
